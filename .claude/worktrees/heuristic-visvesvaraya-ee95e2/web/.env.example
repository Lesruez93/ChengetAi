# FastAPI backend URL (server-side only; see src/lib/config.ts)
CHENGETAI_API_BASE_URL=http://localhost:8000

# Admin dashboard login. MVP-only: a single shared password, not per-admin
# accounts. See src/lib/auth.ts for why, and the roadmap note there.
ADMIN_PASSWORD=changeme
# Optional: separate secret used to derive the session cookie, so rotating
# ADMIN_PASSWORD doesn't need to also invalidate it deliberately. Falls back
# to ADMIN_PASSWORD if unset.
ADMIN_SESSION_SECRET=changeme-too
# Demo convenience only: prefills the login form's password input so judges
# can one-click sign in. This value ships in the public JS bundle — keep it
# equal to ADMIN_PASSWORD for a public demo, and unset both before this ever
# gates real user data.
NEXT_PUBLIC_ADMIN_DEMO_PASSWORD=changeme
