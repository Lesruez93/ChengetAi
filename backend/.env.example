# --- App ---
APP_ENV=development                 # development | production
LOG_LEVEL=info

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=changeme
SUPABASE_ANON_KEY=changeme
# When unset in development, the backend falls back to an in-memory store
# (see app/services/store.py) so the API is runnable without a live project.
USE_SUPABASE=false

# --- Classifier ---
CLASSIFIER_STRATEGY=baseline        # baseline | llm
ANTHROPIC_API_KEY=changeme
ANTHROPIC_MODEL=claude-sonnet-5

# --- Messaging (Twilio) ---
SMS_TRANSPORT=console               # console | twilio
TWILIO_ACCOUNT_SID=changeme
TWILIO_AUTH_TOKEN=changeme
TWILIO_FROM_NUMBER=+10000000000

# --- Reputation / abuse controls ---
REPORT_RATE_LIMIT_PER_HOUR=5
NUMBER_PUBLIC_FLAG_THRESHOLD=3      # min distinct, trusted reports before a number is publicly flagged
